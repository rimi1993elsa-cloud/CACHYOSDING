	optdepends = cachyos-control-center-stt-de: German Vosk model integration directory
	optdepends = cachyos-control-center-doc-index: offline source registry and documentation
	optdepends = libsecret: OpenAI API key through Secret Service or KDE Wallet
	optdepends = networkmanager: network management
	optdepends = pipewire-pulse: audio management
